{
  "schemaVersion": 1,
  "projectId": "nous-hermes-agent",
  "dashboardKit": {
    "baseline": "hdk-first",
    "package": "@hermes/dashboard-kit",
    "requiredVersion": "0.1.0",
    "adoptionMode": "package-native",
    "implementationMode": "package-native",
    "staticAdapterAllowed": false,
    "currentExperienceTier": 3,
    "targetExperienceTier": 3,
    "targetExperienceBand": "T3C",
    "packageNativeRequired": true,
    "mobbinReferenceRequired": true,
    "customComponentsPolicy": "allowed-only-inside-hdk-shell-and-token-contracts",
    "shell": "hdk",
    "sidebar": "hdk",
    "header": "hdk",
    "theme": "hdk",
    "spacing": "hdk",
    "auth": "hdk-compatible",
    "tierMigrationRequired": false,
    "tierMigrationNote": "Nous Hermes Agent owns the dashboard standards/control-plane surface and must follow the same package-native evidence contract as downstream dashboards."
  },
  "referenceIntake": {
    "path": "docs/design/dashboard-kit-reference-intake.md",
    "required": true
  },
  "designReview": {
    "path": "docs/design/dashboard-kit-design-review.md",
    "required": true
  },
  "proof": {
    "playwrightConfig": "web/playwright.config.ts",
    "captureScript": "scripts/capture-dashboard-visual-baseline.mjs",
    "screenshotStates": [
      "light",
      "dark",
      "system"
    ]
  },
  "enforcement": {
    "localScripts": [
      "hdk:check",
      "hdk:proof",
      "hdk:visual"
    ],
    "creationGate": "hdk:check",
    "deployGate": "hdk:check",
    "exceptionsRequireExpiry": true,
    "staticEntrypointAllowlist": [
      "apps/bootstrap-installer/**",
      "docs/**",
      "hermes_cli/**",
      "skills/**",
      "web/index.html"
    ]
  },
  "surfaces": [
    {
      "id": "hermes-dashboard-kit-gallery",
      "path": "packages/hermes-dashboard-kit/src/index.js",
      "role": "kit-source",
      "status": "production",
      "requiredComponents": [
        "DashboardKitGallery",
        "PremiumComparisonChart",
        "PremiumMarketBrowser",
        "PremiumMediaApprovalWorkspace",
        "PremiumPlannerCalendar",
        "PremiumDrilldownWorkspace",
        "DashboardShell",
        "DashboardSidebar",
        "DashboardHeader",
        "DashboardQueryBoundary",
        "DataFreshnessStrip",
        "ProofStrip",
        "StatePanel",
        "MetricCard",
        "ActionQueue"
      ],
      "markers": [
        "renderDashboardKitGallery",
        "renderPremiumComparisonChart",
        "renderPremiumMarketBrowser",
        "renderPremiumMediaApprovalWorkspace",
        "renderPremiumPlannerCalendar",
        "renderPremiumDrilldownWorkspace"
      ],
      "notes": "Canonical server-rendered gallery generator for dashboard-kit component review and maturity evidence. Platform-required component families are synchronized from .hermes-dashboard-platform.json so local routes cannot pass with only generic shell declarations."
    },
    {
      "id": "hermes-dashboard-kit-gallery-web-route",
      "path": "web/src/pages/DashboardKitGalleryPage.tsx",
      "role": "page-content",
      "status": "production",
      "requiredComponents": [
        "DashboardKitGallery",
        "ProofStrip",
        "DataTable",
        "ChartPanel",
        "PremiumComparisonChart",
        "PremiumMarketBrowser",
        "PremiumMediaApprovalWorkspace",
        "PremiumPlannerCalendar",
        "PremiumDrilldownWorkspace"
      ],
      "markers": [
        "data-review-id=\"hermes.dashboard-kit-gallery\"",
        "dashboardKitGalleryReport",
        "dashboard-kit-gallery-kit.css",
        "report.qualityGraphHtml",
        "hdk-gallery-actual-demo",
        "DashboardKitGallery",
        "ProofStrip",
        "DataTable",
        "ChartPanel"
      ],
      "notes": "Operator-facing gallery route inside the Nous Hermes web shell."
    }
  ],
  "exceptions": [
    {
      "id": "react-app-shell-owned-by-web-app",
      "scope": "surface",
      "surface": "hermes-dashboard-kit-gallery-web-route",
      "reason": "The gallery route is page content inside the existing React application shell. Shell/sidebar/header evidence lives in web/src/App.tsx instead of being re-rendered inside the page route.",
      "expiresAt": "2026-09-30"
    }
  ]
}
