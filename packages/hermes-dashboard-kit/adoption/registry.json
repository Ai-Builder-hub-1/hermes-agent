{
  "schemaVersion": 1,
  "source": {
    "package": "@hermes/dashboard-kit",
    "version": "0.1.0",
    "cssPath": "packages/hermes-dashboard-kit/static/hermes-dashboard-kit.css",
    "designContractPath": "packages/hermes-dashboard-kit/DESIGN.md",
    "minimumRequiredVersion": "0.1.0"
  },
  "legacyPatterns": [
    {
      "id": "inline-svg-chart-function",
      "pattern": "function chart(",
      "severity": "error",
      "message": "Surface still renders one-off inline chart functions instead of adopting dashboard-kit chart primitives."
    },
    {
      "id": "inline-depth-chart-function",
      "pattern": "function depthChart(",
      "severity": "error",
      "message": "Surface still renders one-off depth chart functions instead of adopting LiquidityDepthChart or the static chart-surface contract."
    },
    {
      "id": "prototype-preview-copy",
      "pattern": "prototype preview",
      "severity": "warning",
      "message": "Production-facing surfaces should not present real data as prototype preview copy."
    },
    {
      "id": "local-chart-card-only",
      "pattern": "class=\"chart-card\"",
      "severity": "warning",
      "message": "Surface uses local chart-card styling; confirm it is backed by dashboard-kit chart surface classes."
    }
  ],
